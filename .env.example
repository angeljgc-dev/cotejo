# Plantilla de configuración de Cotejo. Copia este archivo como .env (que no se versiona) y ajusta los valores.
# En desarrollo: uv run --env-file .env uvicorn cotejo.api.app:app --reload
# Variable vacía = se usa el valor por omisión indicado en el comentario.

# Entorno: desarrollo, pruebas o produccion (valor por omisión si se deja vacía). En produccion SECRET_KEY es
# obligatoria; en desarrollo, sin ella se usa una clave temporal por proceso.
ENTORNO=desarrollo

# Base de datos PostgreSQL 16 con la extensión vector (pgvector). Acepta postgres:// o postgresql://.
# Ejemplo: postgresql://usuario:contrasena@localhost:5432/cotejo
# Para las pruebas el nombre de la base debe contener "test"; si se deja vacía, las pruebas levantan un
# PostgreSQL local propio.
DATABASE_URL=

# Clave para firmar la cookie de sesión y el hash de IP. Mínimo 32 caracteres.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 1 cuando el sitio se sirve por HTTPS (cookie Secure y cabecera HSTS). Por omisión 0.
COOKIE_SEGURA=0

# 1 detrás del balanceador del hospedaje: la IP del visitante se toma de X-Forwarded-For. Por omisión 0.
CONFIAR_PROXY=0

# Valor de frame-ancestors en la política de contenido. Por omisión 'none' (no se puede incrustar).
FRAME_ANCESTORS='none'

# Empresa receptora de las facturas (una sola empresa por instalación). RFC de prueba, no real.
EMPRESA_RFC=EKU9003173C9
EMPRESA_NOMBRE=Comercializadora Ficticia del Centro
ZONA_HORARIA=America/Mexico_City

# Fecha de "hoy" fija en formato AAAA-MM-DD. Solo para pruebas y evaluación; vacía en uso normal.
FECHA_HOY_FIJA=

# Modo demostración: entrar con un clic como capturista o aprobador. Por omisión 0.
DEMO_HABILITADA=0
# Sembrar datos ficticios al arrancar si la base está vacía. Por omisión 0.
SEMBRAR_SI_VACIA=0
# Semilla de los datos ficticios (misma semilla, mismos datos).
SEMILLA=20261102

# Modelo de lenguaje con API compatible con OpenAI. Sin LLM_API_KEY el asistente queda desactivado con aviso
# y el resto de Cotejo funciona igual.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELO=openai/gpt-oss-120b
LLM_API_KEY=

# Límites diarios de uso (día según ZONA_HORARIA).
CHAT_LIMITE_VISITANTE_DIA=20
CHAT_LIMITE_GLOBAL_DIA=60
CARGAS_LIMITE_VISITANTE_DIA=60

# Embeddings: fastembed (modelo real) o determinista (solo pruebas).
EMBEDDINGS_PROVEEDOR=fastembed
EMBEDDINGS_MODELO=intfloat/multilingual-e5-small
EMBEDDINGS_ARCHIVO=onnx/model.onnx
# Revisión (hash de commit) fijada del modelo de embeddings.
EMBEDDINGS_REVISION=
# Carpeta de caché de los modelos descargados (la usa la biblioteca de Hugging Face).
HF_HOME=/opt/modelos

# Búsqueda: hibrida (vector y texto) o texto (solo texto completo, para hospedajes con poca memoria).
BUSQUEDA_MODO=hibrida

# Carpeta con los archivos construidos del frontend. Si no existe, la API funciona sin servirlos.
STATIC_DIR=/app/static

# Usuario con el que actúa el servidor MCP (debe existir y tener rol capturista).
MCP_USUARIO=demo.capturista

# Pausa en segundos entre llamadas de la evaluación con modelo real.
EVAL_PAUSA_S=3
